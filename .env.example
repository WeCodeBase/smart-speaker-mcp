# ─────────────────────────────────────────────────────────────────────────────
# Smart Speaker MCP — Environment Config
# Location: ~/.config/smart-speaker-mcp/.env
#
# Copy this file there and fill in your values.
# Lines starting with # are comments. Blank lines are ignored.
# Values already set in the shell environment take priority over this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Playback defaults ─────────────────────────────────────────────────────────

# Default speaker to play on (exact name shown by discover_devices)
SMART_SPEAKER_DEFAULT_DEVICE=Family Room speaker

# Default audio source: local | youtube | url
SMART_SPEAKER_SOURCE=local

# ── Local music ───────────────────────────────────────────────────────────────

# Folder containing your MP3 / FLAC / M4A files
SMART_SPEAKER_MUSIC_DIR=~/Music

# ── yt-dlp (YouTube fallback) ─────────────────────────────────────────────────

# Full path to yt-dlp binary (auto-detected from common locations if blank)
SMART_SPEAKER_YTDLP_PATH=

# ── Web control panel ────────────────────────────────────────────────────────
# Port for the embedded web UI. Defaults to 8765. If the port is taken at
# startup, the server falls back to an OS-assigned random port and prints
# the chosen URL on stderr (visible in Claude Desktop's MCP server log).
SMART_SPEAKER_WEB_PORT=8765
