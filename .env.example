# ─────────────────────────────────────────────────────────────────────────────
# Smart Speaker MCP — Environment Config
# Location: ~/.config/smart-speaker-mcp/.env
#
# Copy this file there and fill in your values.
# Lines starting with # are comments. Blank lines are ignored.
# Values already set in the shell environment take priority over this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Playback defaults ─────────────────────────────────────────────────────────

# Default speaker to play on (exact name shown by gh_discover_devices)
SMART_SPEAKER_DEFAULT_DEVICE=Family Room speaker

# Device type: google_home | alexa | both
SMART_SPEAKER_DEVICE_TYPE=google_home

# Default audio source: local | youtube | url
SMART_SPEAKER_SOURCE=local

# ── Local music ───────────────────────────────────────────────────────────────

# Folder containing your MP3 / FLAC / M4A files
SMART_SPEAKER_MUSIC_DIR=~/sundar/songs

# ── yt-dlp (YouTube fallback) ─────────────────────────────────────────────────

# Full path to yt-dlp binary (auto-detected if left blank)
SMART_SPEAKER_YTDLP_PATH=/usr/local/bin/yt-dlp

# ── Amazon Alexa credentials ──────────────────────────────────────────────────
# Get these from https://developer.amazon.com after creating a Login with Amazon app.
# Tip: keep secrets here instead of the JSON config so they are never committed to git.

ALEXA_CLIENT_ID=
ALEXA_CLIENT_SECRET=
ALEXA_ACCESS_TOKEN=
ALEXA_REFRESH_TOKEN=
ALEXA_CUSTOMER_ID=
